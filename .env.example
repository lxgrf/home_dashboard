# .env

# Set your precise home coordinates for the Open-Meteo Weather API
LATITUDE=51.5072
LONGITUDE=-0.1276

# Target indoor relative humidity threshold (%) used to determine whether opening a window will help
TARGET_HUMIDITY=55.0

# --- Zigbee zones ---
# The dashboard tracks three zones. Upstairs alone decides the window verdict
# (the dehumidifier lives there); the other two are displayed for interest.
#
# Each value is the zigbee2mqtt friendly name of that zone's sensor. If you
# rename your devices to "upstairs" / "downstairs" / "conservatory" in the
# zigbee2mqtt frontend, you can leave all three unset.
#
# To add a sensor: enable permit-join, plug in ONE sensor, and the single new
# device that appears in the frontend is the one you just installed. Rename it
# there, then repeat. Check /sensors to see what the dashboard is receiving.
#ZONE_UPSTAIRS=0x00158d0001234567
#ZONE_DOWNSTAIRS=downstairs
#ZONE_CONSERVATORY=conservatory

# A reading older than this (seconds) is shown as "--" rather than a stale
# number, and turns the render timestamp red. Default 30 minutes.
STALE_AFTER=1800

# MQTT topic filter for sensor state. The wildcard segment is the device's
# friendly name; bridge traffic and per-device sub-topics are ignored.
MQTT_TOPIC=zigbee2mqtt/+
